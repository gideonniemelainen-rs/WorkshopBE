{
    "uid": "redpanda-connect",
    "title": "Redpanda Connect Consumer",
    "tags": ["wikistream", "redpanda-connect"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 1,
    "editable": true,
    "refresh": "10s",
    "time": { "from": "now-1h", "to": "now"},
    "templating": { "list": []},
    "annotations": {"list": []},
    "panels": [
        {
            "id": 1,
            "type": "timeseries",
            "title": "Consumer input and output rate",
            "description": "Messages received from Redpanda vs. messages sent to Scylla (built-in Connect metrics)",
            "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
            "datasource": { "type": "prometheus", "uid": "prometheus"},
            "fieldConfig": { "defaults": { "unit": "ops"}, "overrides": []},
            "options": {
                "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true},
                "tooltip": { "mode": "multi", "sort": "none"}
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": { "type": "prometheus", "uid": "prometheus"},
                    "expr": "sum(rate(input_received[1m]))",
                    "legendFormat": "received from Redpanda"
                },
                {
                    "refId": "B",
                    "datasource": { "type": "prometheus", "uid": "prometheus"},
                    "expr": "sum(rate(output_sent[1m]))",
                    "legendFormat": "sent to Scylla"
                }
            ]
        },
        {
            "id": 2,
            "type": "timeseries",
            "title": "Consumer errors",
            "description": "Decode failures (processor_error) and write failures (output_error)",
            "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
            "datasource": { "type": "prometheus", "uid": "prometheus"},
            "fieldConfig": { "defaults": { "unit": "ops"}, "overrides": []},
            "options": {
                "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true},
                "tooltip": { "mode": "multi", "sort": "none"}
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": { "type": "prometheus", "uid": "prometheus"},
                    "expr": "sum(rate(processor_error[1m]))",
                    "legendFormat": "decode (processor)"
                },
                {
                    "refId": "B",
                    "datasource": { "type": "prometheus", "uid": "prometheus"},
                    "expr": "sum(rate(output_error[1m]))",
                    "legendFormat": "write (output)"
                }
            ]
        },
        {
            "id": 3,
            "type": "timeseries",
            "title": "Scylla write latency",
            "description": "Output latency reported by Connect (summary quantiles)",
            "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
            "datasource": { "type": "prometheus", "uid": "prometheus"},
            "fieldConfig": { "defaults": { "unit": "ns"}, "overrides": []},
            "options": {
                "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true},
                "tooltip": { "mode": "multi", "sort": "none"}
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": { "type": "prometheus", "uid": "prometheus"},
                    "expr": "max(output_latency_ns{quantile=\"0.5\"})",
                    "legendFormat": "p50"
                },
                {
                    "refId": "B",
                    "datasource": { "type": "prometheus", "uid": "prometheus"},
                    "expr": "max(output_latency_ns{quantile=\"0.99\"})",
                    "legendFormat": "p99"
                }
            ]
        },
        {
            "id": 4,
            "type": "stat",
            "title": "Connection status",
            "description": "1 = connected to Redpanda (input) and Scylla (output)",
            "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
            "datasource": { "type": "prometheus", "uid": "prometheus"},
            "fieldConfig": {
                "defaults": {
                    "mappings": [],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "color": "red", "value": null},
                            { "color": "green", "value": 1}
                        ]
                    }
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false},
                "orientation": "auto",
                "textMode": "value_and_name",
                "colorMode": "background",
                "graphMode": "none"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": { "type": "prometheus", "uid": "prometheus"},
                    "expr": "max(input_connection_up)",
                    "legendFormat": "Redpanda input"
                },
                {
                    "refId": "B",
                    "datasource": { "type": "prometheus", "uid": "prometheus"},
                    "expr": "max(output_connection_up)",
                    "legendFormat": "Scylla output"
                }
            ]
        },
        {
            "id": 5,
            "type": "timeseries",
            "title": "Backported consumer counters",
            "description": "Same names as the WikiStream Pipeline dashboard, published by the Connect metric processors",
            "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
            "datasource": { "type": "prometheus", "uid": "prometheus"},
            "fieldConfig": { "defaults": { "unit": "ops"}, "overrides": []},
            "options": {
                "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true},
                "tooltip": { "mode": "multi", "sort": "none"}
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": { "type": "prometheus", "uid": "prometheus"},
                    "expr": "rate(wikistream_consumer_redpanda_events_consumed_total[1m])",
                    "legendFormat": "consumed from Redpanda"
                },
                {
                    "refId": "B",
                    "datasource": { "type": "prometheus", "uid": "prometheus"},
                    "expr": "rate(wikistream_consumer_events_processed_total[1m])",
                    "legendFormat": "processed (before write)"
                }
            ]
        },
        {
            "id": 6,
            "type": "timeseries",
            "title": "Events by server (top 10)",
            "description": "Event rate per server_name from the per-server Connect counter (5m window)",
            "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24},
            "datasource": { "type": "prometheus", "uid": "prometheus"},
            "fieldConfig": { "defaults": { "unit": "ops"}, "overrides": []},
            "options": {
                "legend": { "displayMode": "list", "placement": "right", "showLegend": true},
                "tooltip": { "mode": "multi", "sort": "desc"}
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": { "type": "prometheus", "uid": "prometheus"},
                    "expr": "topk(10, sum by (server_name) (rate(wikistream_consumer_events_by_server_total[5m])))",
                    "legendFormat": "{{server_name}}"
                }
            ]
        }
    ]
}
